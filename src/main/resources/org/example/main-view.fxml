<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.MainController"
            style="-fx-font-family: 'Noto Sans CJK JP';">

    <top>
        <HBox spacing="10">
            <padding>
                <Insets
                        top="12"
                        right="12"
                        bottom="12"
                        left="12"/>
            </padding>

            <Label text="%language"/>
            <ComboBox
                    fx:id="languageBox"
                    onAction="#changeLanguage"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding>
                <Insets
                        top="0"
                        right="12"
                        bottom="12"
                        left="12"/>
            </padding>

            <HBox spacing="8">
                <Label text="%temperature"/>
                <TextField fx:id="temperatureField"/>

                <Label text="%from"/>
                <ComboBox fx:id="fromBox"/>

                <Label text="%to"/>
                <ComboBox fx:id="toBox"/>
            </HBox>

            <HBox spacing="8">
                <Label text="%distance"/>
                <TextField fx:id="distanceField"/>
            </HBox>

            <HBox spacing="8">
                <Label text="%time"/>
                <TextField fx:id="timeField"/>
            </HBox>

            <Button
                    text="%convertSave"
                    onAction="#convertAndSave"/>

            <TableView
                    fx:id="recordTable"
                    VBox.vgrow="ALWAYS">

                <columns>
                    <TableColumn
                            fx:id="fromColumn"
                            text="%fromColumn"/>

                    <TableColumn
                            fx:id="toColumn"
                            text="%toColumn"/>

                    <TableColumn
                            fx:id="distanceColumn"
                            text="%distanceColumn"/>

                    <TableColumn
                            fx:id="timeColumn"
                            text="%timeColumn"/>

                    <TableColumn
                            fx:id="speedColumn"
                            text="%speedColumn"/>
                </columns>
            </TableView>

            <Label fx:id="messageLabel"/>
        </VBox>
    </center>
</BorderPane>